# =========================================================================
# liveqna configuration — copy to .env and adjust.
# All three services (capture, stt, ui) read their relevant subset of this
# file as *defaults* at container boot. Once running, the UI's left panel
# lets you change any of this live for the current session via each
# service's /configure endpoint — this file only seeds the initial state.
# =========================================================================

# --- ui ---
UI_PORT=8080
CAPTURE_URL=http://capture:8081
STT_URL=http://stt:8082
STT_WS_URL=ws://stt:8082

# --- capture ---
CAPTURE_PORT=8081
# Empty = resolved at runtime from the live source picker in the UI.
CAPTURE_SOURCE_NODE=
CAPTURE_SAMPLE_RATE=16000
CAPTURE_CHANNELS=1
# PipeWire runtime dir / socket inside the container (bind-mounted from host).
XDG_RUNTIME_DIR=/run/user/1000
PIPEWIRE_RUNTIME_DIR=/run/user/1000

# --- stt ---
STT_PORT=8082
# local | openai | deepgram
STT_BACKEND=local

# local backend (faster-whisper / ctranslate2)
STT_MODEL_SIZE=small
STT_DEVICE=cuda
# GTX 1080 Ti (Pascal) has no efficient fp16 tensor cores -> int8_float32.
STT_COMPUTE_TYPE=int8_float32
STT_LANGUAGE=en
HF_HOME=/cache/huggingface

# VAD-gated incremental decoding (local backend only)
VAD_AGGRESSIVENESS=2
SILENCE_DURATION_MS=700
MIN_SPEECH_MS=250
MAX_SEGMENT_MS=12000

# openai backend
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_CHUNK_MS=4000

# deepgram backend
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# --- speaker-id ---
SPEAKER_ID_PORT=8083
SPEAKER_ID_URL=http://speaker-id:8083
SPEAKER_ID_WS_URL=ws://speaker-id:8083
# Hugging Face token with access accepted on pyannote/segmentation and
# pyannote/overlapped-speech-detection (both gated, free click-through).
# https://huggingface.co/pyannote/segmentation
# https://huggingface.co/pyannote/overlapped-speech-detection
# https://huggingface.co/settings/tokens
PYANNOTE_HF_TOKEN=
# ecapa (SpeechBrain ECAPA-TDNN, default -- much better speaker separation,
# especially on video/produced audio with shared background music) |
# resemblyzer (lighter/faster, but prone to false merges on such audio --
# see conversation history).
EMBEDDING_BACKEND=ecapa
# Cosine similarity above which a new utterance is matched to an existing
# speaker instead of starting a new one. Each embedding backend has its
# own similarity scale (see embeddings/*_backend.py default_similarity_threshold)
# and applies its own calibrated default at startup -- only set this if
# you want to override that default for the currently-selected backend.
# SPEAKER_SIMILARITY_THRESHOLD=
# Minimum utterance length before attempting speaker embedding/clustering.
SPEAKER_MIN_UTTERANCE_MS=500
# Minimum utterance length before a *new* speaker_id may be minted. Below
# this, an utterance can still match an existing known speaker, but if
# nothing matches it is reported as unknown rather than fabricating a new
# identity from what is likely a too-short, unreliable embedding (e.g.
# "Yeah.", "Thank you." -- see conversation history).
SPEAKER_MIN_NEW_SPEAKER_MS=1500
OVERLAP_DETECTION_ENABLED=true
# Overlap detection tiles short clips to fill the model's fixed 10s
# window; below OVERLAP_MIN_CLIP_MS the tiling repetition itself was
# measured to produce false "2 speakers" positives on real audio, so
# detection is skipped entirely below this length. OVERLAP_MIN_RUN_MS
# additionally requires a contiguous run of multi-speaker frames of at
# least this length before flagging overlap. IMPORTANT: a real-audio
# scan found this false-positive artifact (single continuous voice
# misread as 2 speakers at a word boundary) producing runs as long as
# ~2000ms, with no acoustically-confirmed genuine overlap found to
# calibrate against -- OVERLAP_MIN_RUN_MS defaults conservatively above
# that ceiling. This will likely miss some short genuine overlaps; see
# overlap.py for the full methodology and caveats.
OVERLAP_MIN_CLIP_MS=2000
OVERLAP_MIN_RUN_MS=2500
SPEAKER_ID_SAMPLE_RATE=16000

# Qdrant stores enrolled speaker profiles (persisted across restarts/calls,
# keyed by name). Non-enrolled speakers still get the existing anonymous
# auto-clustering behavior.
QDRANT_URL=http://qdrant:6333
# Minimum enrollment clip length -- shorter clips produce unreliable
# reference embeddings (see conversation history on short-utterance
# unreliability).
ENROLLMENT_MIN_CLIP_SECONDS=5
