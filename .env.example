# =========================================================================
# liveqna configuration — copy to .env and adjust.
# Services read their relevant subset of this
# file as *defaults* at container boot. Once running, the UI's left panel
# lets you change any of this live for the current session via each
# service's /configure endpoint — this file only seeds the initial state.
# =========================================================================

# --- ui ---
UI_PORT=8080
CAPTURE_URL=http://capture:8081
STT_URL=http://stt:8082
STT_WS_URL=ws://stt:8082
ORCHESTRATOR_URL=http://orchestrator:8083
# Persistent audit records: one JSON and one PDF per Live Q&A session.
LIVE_LOGS_DIR=/data/live-session-logs
# Human-readable timestamps written into log JSON/PDF files.
LIVE_LOGS_TIMEZONE=Europe/Rome

# --- automatic live-session boundaries ---
# Milliseconds without a new partial/final transcript event before the current
# buffer is sent to the Supervisor. This is an extra debounce after STT/VAD;
# with the local STT default, 500 ms follows its 700 ms silence close condition.
LIVE_SESSION_SILENCE_MS=500
# Maximum age of the current buffer, measured from its first transcript text.
# At this limit the Supervisor must decide READY or IGNORE and cannot return WAIT.
LIVE_SESSION_MAX_WAIT_MS=18000
# Maximum words allowed in one buffer. Reaching this also forces READY or IGNORE;
# whichever hard limit is reached first (time or words) wins.
LIVE_SESSION_MAX_WORDS=140
# After End Live Q&A stops capture, wait this many milliseconds for an in-flight
# STT partial/final decode, then force the remaining buffer to READY or IGNORE.
LIVE_SESSION_FINALIZE_GRACE_MS=3000

# --- offline ingestion ---
INGESTION_PORT=8084
INGESTION_DB_NAME=liveqna
INGESTION_DB_USER=liveqna
# Local-development credential for the container network only.
INGESTION_DB_PASSWORD=liveqna-local
# Stored in approved document-version metadata; there is no auth layer yet.
INGESTION_APPROVED_BY=local-owner
# PPTX hybrid extraction: openai | ollama
INGESTION_VISION_PROVIDER=openai
INGESTION_VISION_MODEL=gpt-4.1-mini
# 0..2; blank omits the parameter for models that do not support temperature.
INGESTION_VISION_TEMPERATURE=0
INGESTION_VISION_DETAIL=high
INGESTION_VISION_PROMPT_VERSION=pptx-slide-v4
INGESTION_VISION_TIMEOUT_SECONDS=120
INGESTION_VISION_MAX_RETRIES=1
INGESTION_VISION_MAX_OUTPUT_TOKENS=4000
INGESTION_VISION_MAX_CONCURRENCY=4
# Independent LLM judge: second multimodal call for every PPTX slide. It checks
# the image, native extraction, visual extraction, and deterministic
# reconciliation. Provider and model can differ from the first vision call.
INGESTION_JUDGE_PROVIDER=openai
INGESTION_JUDGE_MODEL=gpt-4.1-mini
# Independent from visual extraction.
INGESTION_JUDGE_TEMPERATURE=0
INGESTION_JUDGE_DETAIL=high
INGESTION_JUDGE_PROMPT_VERSION=pptx-slide-review-v1
INGESTION_JUDGE_TIMEOUT_SECONDS=120
INGESTION_JUDGE_MAX_RETRIES=1
INGESTION_JUDGE_MAX_OUTPUT_TOKENS=2500
# Human-answer resolver. It proposes corrected normalized Markdown for one
# discrepancy, and can be swapped independently from extraction and judging.
INGESTION_RESOLVER_PROVIDER=openai
INGESTION_RESOLVER_MODEL=gpt-4.1-mini
# Independent from extraction and judging.
INGESTION_RESOLVER_TEMPERATURE=0
INGESTION_RESOLVER_DETAIL=high
INGESTION_RESOLVER_PROMPT_VERSION=pptx-human-resolution-v1
INGESTION_RESOLVER_TIMEOUT_SECONDS=120
INGESTION_RESOLVER_MAX_RETRIES=1
INGESTION_RESOLVER_MAX_OUTPUT_TOKENS=3000
# TXT and Markdown are decoded as strict UTF-8 and normalized deterministically.
# These limits bound memory, parser work, block fan-out, and pathological lines.
INGESTION_TEXT_MAX_BYTES=33554432
INGESTION_TEXT_MAX_LINES=500000
INGESTION_TEXT_MAX_LINE_CHARACTERS=200000
INGESTION_TEXT_MAX_BLOCKS=100000
INGESTION_TEXT_MAX_BLOCK_CHARACTERS=2097152
INGESTION_PDF_RENDER_DPI=144
# PDF first pass is independent from native extraction.
INGESTION_PDF_VISION_PROMPT_VERSION=pdf-page-v2
# PDF uses the common judge/resolver provider and model above with
# PDF-specific prompts.
INGESTION_PDF_JUDGE_PROMPT_VERSION=pdf-page-review-v1
INGESTION_PDF_RESOLVER_PROMPT_VERSION=pdf-human-resolution-v1
# DOCX uses authoritative OOXML extraction plus an isolated LibreOffice Writer
# render of every page. The common vision/judge/resolver providers and models
# above are reused, while each DOCX prompt is independently versioned.
INGESTION_DOCX_SOFFICE_BINARY=soffice
INGESTION_DOCX_RENDER_DPI=144
INGESTION_DOCX_RENDER_TIMEOUT_SECONDS=180
INGESTION_DOCX_VISION_PROMPT_VERSION=docx-page-v1
INGESTION_DOCX_JUDGE_PROMPT_VERSION=docx-page-review-v1
INGESTION_DOCX_RESOLVER_PROMPT_VERSION=docx-human-resolution-v1
# final excludes deleted revisions and keeps inserted revisions; original does
# the inverse. Tracked revisions are always surfaced to the review judge.
INGESTION_DOCX_REVISION_POLICY=final
# OOXML package, native-content, and rendered-page safety limits.
INGESTION_DOCX_MAX_PACKAGE_ENTRIES=20000
INGESTION_DOCX_MAX_COMPRESSED_BYTES=134217728
INGESTION_DOCX_MAX_UNCOMPRESSED_BYTES=536870912
INGESTION_DOCX_MAX_COMPRESSION_RATIO=100
INGESTION_DOCX_MAX_PARAGRAPHS=200000
INGESTION_DOCX_MAX_TABLES=20000
INGESTION_DOCX_MAX_PAGES=500
INGESTION_PPTX_RENDER_DPI=144
INGESTION_PPTX_RENDER_TIMEOUT_SECONDS=180
# XLSX uses openpyxl for authoritative native cells and an isolated
# LibreOffice Calc process for formula verification and worksheet rendering.
INGESTION_XLSX_SOFFICE_BINARY=soffice
INGESTION_XLSX_UNO_PYTHON=/usr/bin/python3
INGESTION_XLSX_HELPER_SCRIPT=/app/scripts/xlsx_libreoffice.py
INGESTION_XLSX_RENDER_DPI=144
INGESTION_XLSX_RENDER_TIMEOUT_SECONDS=180
# Maximum pages combined into one worksheet review image.
INGESTION_XLSX_MAX_RENDER_PAGES_PER_SHEET=8
# selective renders formulas, charts, images, formatting, hidden or ambiguous
# sheets; all renders every non-empty sheet. Production safety does not expose
# an off mode because formula verification must not be silently bypassed.
INGESTION_XLSX_VISUAL_MODE=selective
# XLSX uses the common vision/judge/resolver providers and models above with
# worksheet-specific, independently versioned prompts.
INGESTION_XLSX_VISION_PROMPT_VERSION=xlsx-worksheet-v1
INGESTION_XLSX_JUDGE_PROMPT_VERSION=xlsx-worksheet-review-v1
INGESTION_XLSX_RESOLVER_PROMPT_VERSION=xlsx-human-resolution-v1
# OOXML ZIP and workbook resource limits. Files exceeding a limit fail before
# openpyxl or LibreOffice processes them.
INGESTION_XLSX_MAX_PACKAGE_ENTRIES=20000
INGESTION_XLSX_MAX_UNCOMPRESSED_BYTES=536870912
INGESTION_XLSX_MAX_COMPRESSION_RATIO=100
INGESTION_XLSX_MAX_SHEETS=200
INGESTION_XLSX_MAX_CELLS=1000000
# Human-readable timestamps for immutable Gate 2 inspection runs.
INGESTION_GATE2_TIMEZONE=Europe/Rome
# Container path for the disposable Gate 2 inspection cache. Clear all removes
# only this directory's contents; accepted documents and databases are retained.
INGESTION_REVIEW_RUNS_CACHE_DIR=/cache/ingestion/runs

# --- capture ---
CAPTURE_PORT=8081
# Empty = resolved at runtime from the live source picker in the UI.
CAPTURE_SOURCE_NODE=
CAPTURE_SAMPLE_RATE=16000
CAPTURE_CHANNELS=1
# PipeWire runtime dir / socket inside the container (bind-mounted from host).
XDG_RUNTIME_DIR=/run/user/1000
PIPEWIRE_RUNTIME_DIR=/run/user/1000

# --- stt ---
STT_PORT=8082
# local | openai | deepgram
STT_BACKEND=local

# local backend (faster-whisper / ctranslate2)
STT_MODEL_SIZE=small
STT_DEVICE=cuda
# GTX 1080 Ti (Pascal) has no efficient fp16 tensor cores -> int8_float32.
STT_COMPUTE_TYPE=int8_float32
STT_LANGUAGE=en
HF_HOME=/cache/huggingface

# VAD-gated incremental decoding (local backend only)
VAD_AGGRESSIVENESS=2
SILENCE_DURATION_MS=700
MIN_SPEECH_MS=250
MAX_SEGMENT_MS=12000

# openai backend
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_CHUNK_MS=4000

# --- LangGraph orchestrator ---
# OpenAI credentials are read only by backend services and are never sent
# to the browser. For local inference select ollama in the UI instead.
ORCHESTRATOR_DATA_DIR=/data
SUPERVISOR_PROVIDER=openai
SUPERVISOR_MODEL=gpt-6-luna
# Blank omits temperature; set 0..2 only when the selected model supports it.
SUPERVISOR_TEMPERATURE=
SUPERVISOR_REASONING_EFFORT=none
SUPERVISOR_SERVICE_TIER=fast
QUESTION_AGENT_PROVIDER=openai
QUESTION_AGENT_MODEL=gpt-6.1-sol
# Independently configurable from the supervisor.
QUESTION_AGENT_TEMPERATURE=
QUESTION_AGENT_REASONING_EFFORT=low
QUESTION_AGENT_SERVICE_TIER=fast
AGENT_MODEL_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://host.docker.internal:11434

# deepgram backend
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# --- qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=liveqna_chunks
INGESTION_DOCUMENT_DISPLAY_ROOT=/home/ray/projects/liveqna/.data/ingestion/documents
