%%{init: {"flowchart": {"curve": "linear", "nodeSpacing": 85, "rankSpacing": 105}, "themeVariables": {"fontSize": "17px"}}}%%
flowchart TB
    source["Receive the PowerPoint presentation<br/><b>Component:</b> Registry API<br/><b>Script:</b> app/main.py"]
    source -->|"<b>Input file:</b> source.pptx"| coordinator["Coordinate native and visual extraction for each slide<br/><b>Component:</b> PPTX hybrid extractor<br/><b>Script:</b> app/extraction/pptx.py"]

    coordinator --> native["Extract exact text, tables, notes, element IDs and geometry<br/><b>Component:</b> PPTX native extractor<br/><b>Script:</b> app/extraction/pptx.py"]
    coordinator --> render["Render slides and copy the selected PNGs into the review package<br/><b>Component:</b> LibreOfficePptxRenderer and Gate 2 package builder<br/><b>Scripts:</b> app/extraction/pptx_renderer.py<br/>scripts/build_gate2_review_package.py"]

    render -->|"<b>Output files:</b> rendered-slides/slide-####.png"| vision["Extract region text, tables, diagrams and visual meaning<br/><b>Component:</b> Multimodal LLM<br/><b>Script:</b> app/vision/base.py"]

    native -->|"<b>Gate 2 file:</b> native-elements.json"| reconcile["Globally align elements; native exact text and numbers take precedence; quarantine conflicts from retrieval text<br/><b>Component:</b> Element-level reconciler v3<br/><b>Script:</b> app/extraction/pptx_reconcile.py"]
    vision -->|"<b>Gate 2 file:</b> visual-elements.json"| reconcile

    reconcile -->|"<b>Gate 2 file:</b> reconciliation.json"| judge["Independently compare the rendered slide, native extraction, visual result and reconciliation<br/><b>Component:</b> Second multimodal LLM call<br/><b>Script:</b> app/vision/base.py"]

    judge --> decision["Map strict finding categories to severity and decide AUTO_PASS or REVIEW_REQUIRED<br/><b>Component:</b> Deterministic review policy<br/><b>Script:</b> app/extraction/pptx_review.py"]

    decision -->|"<b>Gate 2 file:</b> review-decisions.json"| link["Link slides using order, explicit references, titles, entities, labels and content similarity<br/><b>Component:</b> Explainable slide linker<br/><b>Script:</b> app/extraction/pptx_link.py"]

    link --> normalize["Build the canonical normalized PPTX result<br/><b>Component:</b> NormalizedDocument 1.5<br/><b>Script:</b> app/extraction/models.py"]

    normalize -->|"<b>Output file:</b> normalized.json"| review["Inspect native evidence, visual evidence and the reconciled result<br/><b>Component:</b> Gate 2 human review<br/><b>Script:</b> scripts/build_gate2_review_package.py"]

    normalize -.-> report["Create the slide-by-slide inspection report<br/><b>Component:</b> PPTX report builder<br/><b>Script:</b> app/extraction/pptx_report.py"]
    report -.->|"<b>Output file:</b> PPTX-LLM-SLIDE-REPORT.md"| review
    normalize -.-> exceptions["Create a report containing only slides that require human review<br/><b>Component:</b> PPTX exception report builder<br/><b>Script:</b> app/extraction/pptx_report.py"]
    exceptions -.->|"<b>Output file:</b> PPTX-GATE-2-EXCEPTIONS.pdf"| review

